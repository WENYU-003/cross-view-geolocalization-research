+def save_candidate_provenance_anyvisloc(
+    *,
+    save_path,
+    scene_name,
+    sample_id,
+    candidate_slot,
+    retrieval_rank,
+    ir_order_gallery_block_index,
+    row_start,
+    col_start,
+    patch_h,
+    patch_w,
+    uav_pts_match,
+    ref_pts_match,
+    uav_pts_original,
+    ref_pts_patch,
+    local_x,
+    local_y,
+    dsm_z,
+    valid,
+    pnp_input_2d,
+    pnp_input_3d,
+    pnp_object_points,
+    inlier_indices,
+    predicted_pose,
+    inlier_count,
+    location_error_m,
+):
+    """Persist logging-only candidate provenance without affecting selection."""
+    candidate_dir = Path(save_path) / "candidate_provenance" / f"slot_{int(candidate_slot):02d}"
+    ensure_dir(candidate_dir)
+    np.savez_compressed(
+        str(candidate_dir / "matches_and_pnp_inputs.npz"),
+        uav_pts_match=np.asarray(uav_pts_match, dtype=np.float32),
+        ref_pts_match=np.asarray(ref_pts_match, dtype=np.float32),
+        uav_pts_original=np.asarray(uav_pts_original, dtype=np.float32),
+        ref_pts_patch=np.asarray(ref_pts_patch, dtype=np.float32),
+        local_x=np.asarray(local_x, dtype=np.float32),
+        local_y=np.asarray(local_y, dtype=np.float32),
+        dsm_z=np.asarray(dsm_z, dtype=np.float32),
+        valid=np.asarray(valid, dtype=bool),
+        pnp_input_2d=np.asarray(pnp_input_2d, dtype=np.float32),
+        pnp_input_3d=np.asarray(pnp_input_3d, dtype=np.float32),
+        pnp_object_points=np.asarray(pnp_object_points, dtype=np.float32),
+        inlier_indices=np.asarray(inlier_indices, dtype=np.int32),
+    )
+
+    predicted_pose = predicted_pose or {}
+    pnp_success = (
+        predicted_pose.get("X") is not None
+        and predicted_pose.get("Y") is not None
+        and int(inlier_count) > 0
+    )
+    save_json(
+        candidate_dir / "result.json",
+        {
+            "scene_name": str(scene_name),
+            "sample_id": str(sample_id),
+            "candidate_slot": int(candidate_slot),
+            "retrieval_rank": int(retrieval_rank),
+            "ir_order_gallery_block_index": ir_order_gallery_block_index,
+            "row_start": int(row_start),
+            "col_start": int(col_start),
+            "patch_h": int(patch_h),
+            "patch_w": int(patch_w),
+            "num_matches": int(len(np.asarray(ref_pts_match).reshape(-1, 2))),
+            "num_pnp_input": int(len(np.asarray(pnp_input_2d).reshape(-1, 2))),
+            "pnp_success": bool(pnp_success),
+            "pred_x": predicted_pose.get("X"),
+            "pred_y": predicted_pose.get("Y"),
+            "pred_z": predicted_pose.get("Z"),
+            "inlier_count": int(inlier_count),
+            "location_error_m": location_error_m,
+            "artifact": str(candidate_dir / "matches_and_pnp_inputs.npz"),
+        },
+    )
